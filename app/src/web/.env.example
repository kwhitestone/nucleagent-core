# nucleagent-core web（子应用）本地开发环境变量
# 复制为 .env.local 后按需修改。

# dev server 端口（默认 6688；micro-app 壳应用编排时可注入）
CORE_WEB_PORT=6688

# /api 代理目标（core 后端，默认 http://localhost:6680）
CORE_BACKEND_URL=http://localhost:6680

# 运行时后端地址（注入 import.meta.env.VITE_CORE_BACKEND_URL）。
# 独立运行时若为空，http 层回退到相对路径 /api，由 Vite dev proxy 处理。
# micro-app 壳内通常留空，由壳的反向代理统一转发。
VITE_CORE_BACKEND_URL=
